# ---------------------------------------------------------------------------
# ArenaAgentBridge - copy to `.env` (next to README.md) and edit.
# Every value can also be exported as a normal environment variable; the
# environment wins over this file.
# ---------------------------------------------------------------------------

# --- network ---------------------------------------------------------------
# Loopback only. Do NOT change the host to 0.0.0.0: the bridge exposes your
# logged-in browser session and has no real authentication by default.
AAB_HOST=127.0.0.1
AAB_PORT=8000

# --- request handling ------------------------------------------------------
# How long the server waits for the page to answer (seconds).
AAB_REQUEST_TIMEOUT=300
AAB_MIN_REQUEST_TIMEOUT=5
AAB_MAX_REQUEST_TIMEOUT=3600
# Requests waiting while the page is busy; extras get HTTP 429.
AAB_QUEUE_MAX_SIZE=64
# Refuse absurdly large prompts before typing them into the page.
AAB_MAX_PROMPT_CHARS=200000
AAB_MAX_RESPONSE_CHARS=400000

# --- prompting -------------------------------------------------------------
# agent = short preamble + transcript (best for Hermes/OpenClaw)
# direct = paste the transcript only
AAB_DEFAULT_MODE=agent
# A custom preamble; {transcript} and {last_user} are filled in.
# AAB_AGENT_WRAPPER="Do the task, answer with the final result only.\n\n{transcript}\n\nAnswer:\n{last_user}\n"

# --- response safety -------------------------------------------------------
# off      = do nothing
# detect   = report destructive commands in x_bridge.sanitize_findings
# redact   = replace them with [BLOCKED BY ARENA-AGENT-BRIDGE: <rule>]   (default)
AAB_SANITIZE_MODE=redact
# Optional JSON file with extra rules: {"rules":[{"name":..,"kind":..,"severity":..,"pattern":..}]}
# AAB_PATTERNS_FILE=patterns.json

# --- streaming emulation ---------------------------------------------------
AAB_STREAM_CHUNK_CHARS=32
AAB_STREAM_CHUNK_DELAY_MS=12

# --- authentication (off by default: the API is local-only) ----------------
AAB_REQUIRE_API_KEY=0
AAB_API_KEY=sk-arena

# --- browser connection ----------------------------------------------------
AAB_SINGLE_CLIENT=1
AAB_HEARTBEAT_INTERVAL=20
AAB_CLIENT_HELLO_TIMEOUT=30

# --- testing / demos -------------------------------------------------------
# 1 = no Chrome needed; the server answers with canned text (never for real work)
AAB_MOCK_BROWSER=0
AAB_MOCK_DELAY=0.4

# --- logging ---------------------------------------------------------------
AAB_LOG_LEVEL=INFO
AAB_LOG_JSON=0
